{
  "name": "fluentui-astro-icons",
  "version": "1.1.340",
  "description": "Fluent System Icons for Astro as inline SVG from SSG/SSR. Zero client JavaScript.",
  "type": "module",
  "license": "MIT",
  "author": "L5Z12 as well as fluentui-astro-icons contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/l5z12/fluentui-astro-icons.git"
  },
  "bugs": {
    "url": "https://github.com/l5z12/fluentui-astro-icons/issues"
  },
  "homepage": "https://l5z12.github.io/fluentui-astro-icons/",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=18.17"
  },
  "exports": {
    ".": "./Icon.astro",
    "./render": {
      "types": "./src/render.ts",
      "import": "./src/render.ts",
      "default": "./src/render.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "CHANGELOG.md",
    "Icon.astro",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "src"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "astro dev --root playground",
    "build": "astro build --root playground",
    "preview": "astro preview --root playground",
    "test": "bun test tests",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run test && bun run build",
    "verify:package": "bun scripts/verify-package.ts",
    "release:first": "bun scripts/publish-first.ts",
    "icons:check": "bun scripts/check-upstream.ts"
  },
  "dependencies": {
    "fluentui-web-icons": "1.1.340"
  },
  "peerDependencies": {
    "astro": ">=4"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "astro": "7.3.1",
    "publint": "0.3.24",
    "typescript": "5.9.2"
  },
  "keywords": [
    "astro",
    "astro-component",
    "withastro",
    "fluentui",
    "fluent-system-icons",
    "icons",
    "svg",
    "ssg",
    "ssr"
  ]
}
